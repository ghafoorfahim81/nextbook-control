# A starting point for a PRODUCTION server. Copy it to .env there, fill in the
# empty values, and run `php artisan control:doctor`. See docs/deployment-fa.md.
#
# Never commit the real .env: it holds the licence signing key and the
# database password.

APP_NAME="NextBook Control"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://control.example.com
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nextbook_control
DB_USERNAME=nextbook_control
DB_PASSWORD=

BCRYPT_ROUNDS=12

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database

# Behind nginx or a load balancer: the address(es) of that proxy, comma
# separated (e.g. 127.0.0.1). Use * only if the app can be reached through the
# proxy alone. Left empty, every visitor looks like the proxy.
TRUSTED_PROXIES=

# Made by `php artisan control:keys`. The private key signs licences and must
# never leave this server; the public key is what each NextBook is given.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_GRACE_DAYS=7

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billing@example.com
MAIL_FROM_NAME="NextBook"

WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSAGING_TIMEZONE=Asia/Kabul
MESSAGING_COUNTRY_CODE=93
